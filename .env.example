# NiveshRakshak AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# AI API Key (Optional: Google Gemini or OpenAI)
# If left blank, the application automatically uses the deterministic Rule-Based Red Flag Engine
AI_API_KEY=
AI_PROVIDER=gemini  # Options: gemini, openai

# Database configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./niveshrakshak.db

# OCR configuration (Optional external OCR key, defaults to local extraction)
OCR_API_KEY=

# Speech API configuration (Optional external TTS/STT, defaults to Web Speech API)
SPEECH_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
